# ============================================================================
# TabPFNCredit .gitignore
# ============================================================================

# ---- Data (keep structure only) ----
data/*
!data/.gitkeep

# ---- Images (keep folder only) ----
images/*
!images/.gitkeep

# ---- Results (ignore completely) ----
results/

# ---- Generated configs ----
config_hpo/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.Python

# ---- Virtual Environments ----
.env
.venv/
venv/
env/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDEs ----
.vscode/
.idea/
*.sublime-*

# ---- OS Files ----
.DS_Store
Thumbs.db

# ---- Logs & Temp Files ----
*.log
*.tmp
*.bak

# ---- Model Files ----
*.pth
*.ckpt
*.pkl
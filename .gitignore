# ============================================================================
# TabPFNCredit .gitignore
# ============================================================================

# ---- Data (keep directory structure only) ----
data/*
!data/.gitkeep
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/processed/
data/processed/*

# ---- Images (keep folder only) ----
images/*
!images/.gitkeep

# ---- Results (ignore completely) ----
results/

# ---- Generated HPO configs ----
config_hpo/

# ---- Python bytecode & packaging ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.Python
*.whl

# ---- Virtual environments ----
.env
.venv/
venv/
env/
ENV/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDEs & editors ----
.vscode/
.idea/
*.sublime-*
*.swp
*.swo
*~

# ---- OS files ----
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Logs, temp & backup files ----
*.log
*.tmp
*.bak
*.orig

# ---- Model & checkpoint files ----
*.safetensors
*.cpkt
*.pth
*.ckpt
*.pkl
*.h5
*.hdf5
**/model/models/

# ---- Secrets & credentials ----
*.env.local
.env.production
credentials.json
secrets.json
*.key
*.pem

# ---- Distribution / packaging ----
*.tar.gz
*.zip

# ---- Coverage & testing ----
.coverage
htmlcov/
.pytest_cache/
.tox/

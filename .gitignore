# ============================================================================
# TabPFNCredit .gitignore
# ----------------------------------------------------------------------------
# Rule of thumb: anything small + version-controlled-friendly stays *in* git
# (source, configs, notebooks, tests, README, scripts). Anything large,
# generated, or environment-specific stays *out* (data, results, figures,
# venv, caches, build artifacts).
# ============================================================================

# ---- Datasets (raw + processed) ----
#
# These are large + sometimes copyrighted; never commit. Keep an empty
# placeholder so `data/` exists when the repo is freshly cloned.
#
# IMPORTANT: the leading slash anchors this to the REPO ROOT. Without it,
# `data/` would also match `src/data/` and silently ignore the source package
# there. Always anchor top-level directories with a leading `/`.
/data/
!/data/.gitkeep

# ---- Private dataset-specific preprocessing ----
#
# TEMPORARILY TRACKED (requested) so a loader fix reaches the cluster through
# `git pull` instead of a manual copy. This module contains proprietary
# raw-dataset schema details -- real column names and per-dataset cleaning rules
# -- so committing it publishes them in a public repository. Restore the line
# below once the fix has been deployed:
#
#     /src/data/dataset_preprocessing.py

# ---- Private dataset naming registry ----
#
# Pairs each proprietary dataset's REAL slug with its anonymised paper name
# (PropPD1, PropLGD1, ...) -- i.e. precisely the de-anonymisation key, so it
# must never be published. Keep your local copy at this path.
# src/data/dataset_names.py (tracked) is the public accessor: without the
# registry the code still runs, falling back to raw on-disk slugs.
/src/data/dataset_registry.py

# ---- Experiment results (regenerated by `tabpfncredit experiment`) ----
# Results are regenerated artifacts -- EXCEPT All_Results.md, the printed-text
# dump of every analysis notebook, which is committed so git history shows how
# the results changed run to run. (A dir itself must not be excluded for the
# negation to work, hence /results/* rather than /results/.)
/results/*
!/results/All_Results.md

# ---- Generated figures (regenerated by the notebooks) ----
/figures/

# ---- Generated SLURM scripts + plans (re-emitted every `experiment` run) ----
# The CLI wipes + regenerates these per submission, so they must never be
# committed (stale copies are misleading). README documents them as gitignored.
scripts/*/_generated/

# ---- Foundation-model weights (downloaded by src/utils/fetch_weights.py) ----
# Multi-GB; uploaded to the VSC manually, never committed.
/checkpoints/

# ---- Runtime weights placed at the repo root on the VSC (HyperFast) ----
# scripts/setup_vsc_checkpoints.sh drops hyperfast.ckpt under model/models/...
# (the loader's CWD-relative path). Distinct from the src/ source package.
/model/

# ---- joblib folds cache (auto-rebuilt on first run) ----
/.cache/

# ---- SLURM job logs (written under <repo>/logs/<experiment>/ on the cluster) ----
# Plain `*.log` does not match SLURM's .out/.err files; anchor the whole dir.
/logs/

# ---- JupyterLab scratch ----
.virtual_documents/

# ---- Local editor / tooling config ----
.claude/

# ---- Python: bytecode, build artifacts, editable-install metadata ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.Python
*.whl

# ---- Virtual environments ----
.env
.venv/
venv/
tabpfncreditvenv/
env/
ENV/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE / editor caches ----
.vscode/
.idea/
*.sublime-*
*.swp
*.swo
*~

# ---- OS junk ----
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Logs + temp / backup ----
*.log
*.tmp
*.bak
*.orig

# ---- Coverage / test caches ----
.coverage
htmlcov/
.pytest_cache/
.tox/
.mypy_cache/
.ruff_cache/

# ---- Secrets / credentials (defensive) ----
*.env.local
.env.production
credentials.json
secrets.json
*.key
*.pem

# ---- Large archive blobs ----
*.tar.gz
*.zip
